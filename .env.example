# Copy to .env and fill in real values. Never commit .env.
#
# This file documents every environment variable the backend reads. Locally,
# docker-compose loads it automatically. In production the same variables are
# supplied by the deployment from GitHub environment secrets — production values
# never live in a file inside this repository.

# --- Spring profile -------------------------------------------------------
# Leave empty for local development. Production sets: prod
SPRING_PROFILES_ACTIVE=

# --- Database -------------------------------------------------------------
# In production these are REQUIRED — application-prod.properties declares them
# with no fallback, so a missing value aborts startup instead of silently
# pointing the application at localhost.
#
# Locally there is no shared default either: docker-compose.yml will not start
# until POSTGRES_PASSWORD has a value. Generate one, e.g. `openssl rand -hex 24`.
# A database volume created before this rule was initialised with the old
# default, `password`, and PostgreSQL only reads POSTGRES_PASSWORD when it
# initialises an empty volume. So either keep `password` here for that volume,
# or change it inside the database first:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new value>'"
DATABASE_URL=jdbc:postgresql://localhost:5432/manara_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=manara_db

# --- Redis (session store) ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Set it. docker-compose.yml turns Redis AUTH on whenever this has a value, and
# the application sends it. Empty runs Redis with no AUTH at all, which is
# tolerable only because the development stack publishes Redis on 127.0.0.1
# alone. Production refuses to start without one.
REDIS_PASSWORD=

# --- Session cookie -------------------------------------------------------
# true wherever the site is served over HTTPS. Production defaults to true.
COOKIE_SECURE=false

# --- Email (Resend) -------------------------------------------------------
# Create at https://resend.com/api-keys — the value starts with "re_".
RESEND_API_KEY=

# Sender used by every application email. Its domain must be verified in Resend.
MAIL_FROM=no-reply@manara-edu.com
MAIL_FROM_NAME=Manara
# Where user replies to automated mail should land.
MAIL_REPLY_TO=support@manara-edu.com
