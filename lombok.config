config.stopBubbling = true
# Copy @Qualifier from a final field onto the constructor @RequiredArgsConstructor generates.
# Without this, a field-level @Qualifier is silently ignored and injection falls back to
# by-type, which breaks as soon as a second bean of that type exists (for example the
# `taskScheduler` Executor that @EnableScheduling brings in).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
